---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="KMNZ">

  <h1 class="text-4xl font-bold mb-8">
    KMNZ
  </h1>

  <p class="mb-10">
    好きな歌ってみたや切り抜き。
  </p>

  <section class="space-y-10">

    <div
      class="
        border
        border-emerald-300
        bg-emerald-50
        rounded-2xl
        p-6
      "
    >

      <h2 class="text-2xl font-bold mb-2">
        お気に入り歌ってみた
      </h2>

      <p class="mb-6">
        ハイド・アンド・シーク covered by TINA
      </p>

      <div class="aspect-video">

        <iframe
          class="w-full h-full rounded-xl"
          src="https://www.youtube.com/embed/bNGkNKGOMRI"
          title="YouTube video player"
          frameborder="0"
          allowfullscreen
        ></iframe>

      </div>

    </div>

  </section>

</Layout>