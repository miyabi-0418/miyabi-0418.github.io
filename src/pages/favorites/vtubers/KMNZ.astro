---
import Layout from "../../../layouts/Layout.astro";

const vtuber = {
  name: "KMNZ",

  description: `
けものず。
歌うまイケてるおもろ集団。

3人体制になって本格的にハマった。
`,

  x: "https://x.com/KMNSTREET",
  youtube: "https://www.youtube.com/@KMNZOFFICIAL",
};

const videos = [
  {
    title: "ハイド・アンド・シーク covered by TINA",
    type: "歌ってみた",
    comment: "TINAの透明感ある歌声が最高。",
    youtube: "bNGkNKGOMRI",
  },

  /*
  {
    title: "",
    type: "歌ってみた",
    comment: "",
    youtube: "",
  },
  */
];
---

<Layout title={vtuber.name}>

  <a
    href={`${import.meta.env.BASE_URL}favorites/vtuber`}
    class="
      text-zinc-500
      hover:text-zinc-700
      transition
    "
  >
    ← Vtuber一覧へ戻る
  </a>
  
  <h1 class="text-4xl font-bold mb-4">
    {vtuber.name}
  </h1>

  <p class="whitespace-pre-line text-zinc-700 mb-8">
    {vtuber.description}
  </p>

  <!-- SNS -->
  <div class="flex gap-4 mb-10">

    <a
      href={vtuber.x}
      target="_blank"
      rel="noopener noreferrer"
      class="
        px-4 py-2
        rounded-xl
        bg-zinc-900
        text-white
        hover:bg-zinc-700
        transition
      "
    >
      X
    </a>

    <a
      href={vtuber.youtube}
      target="_blank"
      rel="noopener noreferrer"
      class="
        px-4 py-2
        rounded-xl
        bg-red-600
        text-white
        hover:bg-red-500
        transition
      "
    >
      YouTube
    </a>

  </div>

  <section class="space-y-10">

    {
      videos.map((video) => (

        <div
          class="
            border
            border-emerald-300
            bg-emerald-50
            rounded-2xl
            p-6
          "
        >

          <p
            class="
              text-sm
              text-emerald-800
              font-semibold
              mb-2
            "
          >
            {video.type}
          </p>

          <h2 class="text-2xl font-bold mb-2">
            {video.title}
          </h2>

          <p class="mb-6 text-zinc-700">
            {video.comment}
          </p>

          <div class="aspect-video">

            <iframe
              class="w-full h-full rounded-xl"
              src={`https://www.youtube.com/embed/${video.youtube}`}
              title={video.title}
              frameborder="0"
              allowfullscreen
            ></iframe>

          </div>

        </div>

      ))
    }

  </section>

</Layout>