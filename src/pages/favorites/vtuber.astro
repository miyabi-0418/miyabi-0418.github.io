---
import Layout from "../../layouts/Layout.astro";

const vtubers = [
  {
    name: "小清水透",
    slug: "koshimizu-toru",
  },

  {
    name: "KMNZ",
    slug: "KMNZ",
  },

  /*
  {
    name: "",
    slug: "",
  },
  */
];
---

<Layout title="Vtuber">

  <h1 class="text-4xl font-bold mb-8">
    Vtuber
  </h1>

  <p class="text-zinc-700 mb-8">
    好きなVtuberたち。
  </p>

  <div class="space-y-4">

    {
      vtubers.map((vtuber) => (

        <a
          href={`${import.meta.env.BASE_URL}favorites/vtubers/${vtuber.slug}`}
          class="
            block
            border
            border-zinc-300
            rounded-2xl
            p-4
            hover:bg-zinc-100
            transition
          "
        >
          {vtuber.name}
        </a>

      ))
    }

  </div>

</Layout>