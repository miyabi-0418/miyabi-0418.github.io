---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Vtuber">

  <h1 class="text-4xl font-bold mb-8">
    Vtuber
  </h1>

  <div class="space-y-4">

    <a
      href={`${import.meta.env.BASE_URL}favorites/vtubers/koshimizu-toru`}
      class="block border rounded-2xl p-4 hover:bg-zinc-100"
    >
      小清水透
    </a>

    <a
      href={`${import.meta.env.BASE_URL}favorites/vtubers/KMNZ`}
      class="block border rounded-2xl p-4 hover:bg-zinc-100"
    >
      KMNZ
    </a>

    /*
    <a
      href={`${import.meta.env.BASE_URL}favorites/vtubers/`}
      class="block border rounded-2xl p-4 hover:bg-zinc-100"
    >
      
    </a>
    */

  </div>

</Layout>