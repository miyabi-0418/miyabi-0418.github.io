---
import Layout from "../../layouts/Layout.astro";

const vtubers = [
  {
    name: "小清水透",
    slug: "koshimizu-toru",
    tags: ["にじさんじ", "ゲーム"],
  },

  {
    name: "KMNZ",
    slug: "KMNZ",
    tags: ["RK Music", "歌"],
  },

  {
    name: "七瀬すず菜",
    slug: "nanase-suzuna",
    tags: ["にじさんじ"],
  },

  {
    name: "珠乃井ナナ",
    slug: "tamanoi-nana",
    tags: ["にじさんじ", "歌"],
  },

  {
    name: "周防パトラ",
    slug: "suou-patra",
    tags: ["個人", "歌", "ASMR"],
  },

  {
    name: "ころねぽち",
    slug: "korone-pochi",
    tags: ["個人", "歌"],
  },

  {
    name: "ミミック",
    slug: "mimic",
    tags: ["個人", "動画"],
  },

  {
    name: "HIMEHINA",
    slug: "HIMEHINA",
    tags: ["StudioLaRa", "歌"],
  },

  {
    name: "CULUA",
    slug: "CULUA",
    tags: ["RK Music", "歌"],
  },

  /*
  {
    name: "",
    slug: "",
    tags: ["", ""],
  },
  */
];

vtubers.sort((a, b) =>
  a.name.localeCompare(b.name, "ja")
);

const allTags = [
  ...new Set(
    vtubers.flatMap((vtuber) => vtuber.tags)
  ),
];

---

<Layout title="Vtuber">

  <h1 class="text-4xl font-bold mb-8">
    Vtuber
  </h1>

  <p class="text-zinc-700 mb-8">
    好きなVtuberたち。
    {vtubers.length}人
  </p>

  <div class="flex gap-2 flex-wrap mb-8">

    <button
      data-tag="all"
      class="
        tag-button
        px-3 py-1
        rounded-full
        bg-zinc-700
        text-white
      "
    >
      すべて
    </button>

    {
      allTags.map((tag) => (

        <button
          data-tag={tag}
          class="
            tag-button
            px-3 py-1
            rounded-full
            bg-emerald-200
            text-emerald-900
          "
        >
          #{tag}
        </button>

      ))
    }

  </div>

  <div class="space-y-4">

    {
      vtubers.map((vtuber) => (

        <a
          href={`${import.meta.env.BASE_URL}favorites/vtubers/${vtuber.slug}`}
          data-tags={vtuber.tags.join(",")}
          class="
            vtuber-card
            block
            border
            border-zinc-300
            rounded-2xl
            p-4
            hover:bg-zinc-100
            transition
          "
        >

          <p class="font-bold text-lg">
            {vtuber.name}
          </p>

          <div class="flex gap-2 flex-wrap mt-2">

            {
              vtuber.tags.map((tag) => (

                <span
                  class="
                    text-xs
                    bg-emerald-200
                    text-emerald-900
                    px-2
                    py-1
                    rounded-full
                  "
                >
                  #{tag}
                </span>

              ))
            }

          </div>

        </a>

      ))
    }

  </div>

  <script>

    console.log("script loaded");

    const buttons =
      document.querySelectorAll(".tag-button");

    const cards =
      document.querySelectorAll(".vtuber-card");

    console.log(buttons.length);
    console.log(cards.length);

    buttons.forEach((button) => {

      button.addEventListener("click", () => {

        const selectedTag =
          button.dataset.tag;

        buttons.forEach((btn) => {

          btn.classList.remove(
            "bg-zinc-700",
            "text-white"
          );

          btn.classList.add(
            "bg-emerald-200",
            "text-emerald-900"
          );

        });

        button.classList.remove(
          "bg-emerald-200",
          "text-emerald-900"
        );

        button.classList.add(
          "bg-zinc-700",
          "text-white"
        );

        cards.forEach((card) => {

          const tags =
            card.dataset.tags.split(",");

          if (
            selectedTag === "all" ||
            tags.includes(selectedTag)
          ) {

            card.style.display = "block";

          } else {

            card.style.display = "none";

          }

        });

      });

    });

  </script>

</Layout>