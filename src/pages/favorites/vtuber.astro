---
import Layout from "../../layouts/Layout.astro";

const vtubers = [
  {
    name: "小清水透",
    slug: "koshimizu-toru",
    tags: ["にじさんじ", "ゲーム"],
  },

  {
    name: "KMNZ",
    slug: "KMNZ",
    tags: ["RK Music", "歌"],
  },

  {
    name: "七瀬すず菜",
    slug: "nanase-suzuna",
    tags: ["にじさんじ"],
  },

  {
    name: "珠乃井ナナ",
    slug: "tamanoi-nana",
    tags: ["にじさんじ", "歌"],
  },

  /*
  {
    name: "",
    slug: "",
    tags: [""],
  },
  */
];

vtubers.sort((a, b) =>
  a.name.localeCompare(b.name, "ja")
);

const allTags = [
  ...new Set(
    vtubers.flatMap((vtuber) => vtuber.tags)
  ),
];

const selectedTag = Astro.url.searchParams.get("tag");

const filteredVtubers = selectedTag
  ? vtubers.filter((vtuber) =>
      vtuber.tags.includes(selectedTag)
    )
  : vtubers;

---

<Layout title="Vtuber">

  <h1 class="text-4xl font-bold mb-8">
    Vtuber
  </h1>

  <p class="text-zinc-700 mb-8">
    好きなVtuberたち。
    {vtubers.length}人
  </p>

  <div class="flex gap-2 flex-wrap mb-8">

    <a
      href={`${import.meta.env.BASE_URL}favorites/vtuber`}
      class={
        !selectedTag
          ? `
            px-3 py-1 rounded-full
            bg-zinc-700
            text-white
          `
          : `
            px-3 py-1 rounded-full
            border border-zinc-300
          `
      }
    >
      すべて
    </a>

    {
      allTags.map((tag) => (

        <a
          href={`${import.meta.env.BASE_URL}favorites/vtuber?tag=${tag}`}
          class={
            selectedTag === tag
              ? `
                px-3 py-1 rounded-full
                bg-emerald-600
                text-white
              `
              : `
                px-3 py-1 rounded-full
                bg-emerald-200
                text-emerald-900
              `
          }
        >
          #{tag}
        </a>

      ))
    }

  </div>

  <div class="space-y-4">

    {
      filteredVtubers.map((vtuber) => (

        <a
          href={`${import.meta.env.BASE_URL}favorites/vtubers/${vtuber.slug}`}
          class="
            block
            border
            border-zinc-300
            rounded-2xl
            p-4
            hover:bg-zinc-100
            transition
          "
        >

          <p class="font-bold text-lg">
            {vtuber.name}
          </p>

          <div class="flex gap-2 flex-wrap mt-2">

            {
              vtuber.tags.map((tag) => (

                <span
                  class="
                    text-xs
                    bg-emerald-200
                    text-emerald-900
                    px-2
                    py-1
                    rounded-full
                  "
                >
                  #{tag}
                </span>

              ))
            }

          </div>

        </a>

      ))
    }

  </div>

</Layout>